{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/cron/sync", "destination": "/api/cron/sync" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "* * * * *"
    }
  ]
}
